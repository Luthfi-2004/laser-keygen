{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/generator.html", "destination": "/generator", "permanent": true },
    { "source": "/history.html", "destination": "/history", "permanent": true }
  ],
  "rewrites": [
    { "source": "/generator", "destination": "/generator.html" },
    { "source": "/history", "destination": "/history.html" },
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ]
}
